import { GLView } from 'expo-gl';
import React, { useEffect, useRef, useState } from 'react';
import {
  Pressable,
  SafeAreaView,
  StyleSheet,
  Text,
  View,
} from 'react-native';
import * as THREE from 'three';

type PartId = 'bigGear' | 'smallGear' | 'shaft';

type Point3 = {
  x: number;
  y: number;
  z: number;
};

const COLORS = {
  background: '#FFF9F5',
  paper: '#FFFDFB',
  charcoal: '#34313A',
  muted: '#817985',
  purple: '#8B6FC7',
  purpleDark: '#7655B5',
  lavender: '#9B83D7',
  pink: '#E98FA3',
  peach: '#F2B38F',
  mint: '#86CDB1',
  sky: '#82B8E8',
  yellow: '#F2C96D',
  border: '#E8DDE7',
  softPurple: '#EEE7FA',
  softBlue: '#E8F2FC',
};

const TARGETS: Record<PartId, Point3> = {
  bigGear: { x: -1.45, y: 0.65, z: 0.2 },
  smallGear: { x: 1.35, y: 0.65, z: 0.2 },
  shaft: { x: 0, y: -0.95, z: 0.2 },
};

const PART_LABELS: Record<PartId, string> = {
  bigGear: 'BIG GEAR',
  smallGear: 'SMALL GEAR',
  shaft: 'SHAFT',
};

function createGearGeometry(
  outerRadius: number,
  innerRadius: number,
  teeth: number,
  depth: number,
) {
  const shape = new THREE.Shape();

  const points = teeth * 4;

  for (let i = 0; i <= points; i += 1) {
    const angle = (i / points) * Math.PI * 2;

    const phase = i % 4;

    let radius = outerRadius;

    if (phase === 0 || phase === 3) {
      radius = innerRadius;
    }

    const x = Math.cos(angle) * radius;
    const y = Math.sin(angle) * radius;

    if (i === 0) {
      shape.moveTo(x, y);
    } else {
      shape.lineTo(x, y);
    }
  }

  const geometry = new THREE.ExtrudeGeometry(shape, {
    depth,
    bevelEnabled: true,
    bevelSegments: 3,
    bevelSize: 0.05,
    bevelThickness: 0.05,
  });

  geometry.center();

  return geometry;
}

function makeMaterial(color: string, metalness = 0.2, roughness = 0.45) {
  return new THREE.MeshStandardMaterial({
    color,
    metalness,
    roughness,
  });
}

function addBox(
  scene: THREE.Object3D,
  size: Point3,
  position: Point3,
  color: string,
) {
  const geometry = new THREE.BoxGeometry(size.x, size.y, size.z);
  const mesh = new THREE.Mesh(
    geometry,
    makeMaterial(color, 0.05, 0.65),
  );

  mesh.position.set(position.x, position.y, position.z);
  scene.add(mesh);

  return mesh;
}

function createTargetRing(
  position: Point3,
  color: string,
) {
  const group = new THREE.Group();

  const outer = new THREE.Mesh(
    new THREE.TorusGeometry(0.58, 0.055, 12, 48),
    new THREE.MeshBasicMaterial({
      color,
      transparent: true,
      opacity: 0.9,
    }),
  );

  outer.rotation.x = 0;
  group.add(outer);

  const inner = new THREE.Mesh(
    new THREE.RingGeometry(0.35, 0.43, 32),
    new THREE.MeshBasicMaterial({
      color,
      transparent: true,
      opacity: 0.18,
      side: THREE.DoubleSide,
    }),
  );

  group.add(inner);

  group.position.set(position.x, position.y, position.z);

  return group;
}

function createGear(
  radius: number,
  teeth: number,
  color: string,
) {
  const geometry = createGearGeometry(
    radius,
    radius * 0.78,
    teeth,
    0.22,
  );

  const gear = new THREE.Mesh(
    geometry,
    makeMaterial(color, 0.55, 0.28),
  );

  // Gear is vertical, facing the camera.
  gear.rotation.x = 0;

  return gear;
}

function createMachine(scene: THREE.Scene) {
  const machine = new THREE.Group();

  // Back panel.
  addBox(
    machine,
    { x: 6.4, y: 4.8, z: 0.25 },
    { x: 0, y: 0.2, z: -0.75 },
    '#F1ECFA',
  );

  // Floor.
  addBox(
    machine,
    { x: 7.0, y: 0.25, z: 3.0 },
    { x: 0, y: -1.75, z: 0 },
    '#F8E8DD',
  );

  // Left frame.
  addBox(
    machine,
    { x: 0.28, y: 4.1, z: 0.35 },
    { x: -3.05, y: 0.15, z: 0 },
    '#EBCFBD',
  );

  // Right frame.
  addBox(
    machine,
    { x: 0.28, y: 4.1, z: 0.35 },
    { x: 3.05, y: 0.15, z: 0 },
    '#EBCFBD',
  );

  // Top frame.
  addBox(
    machine,
    { x: 6.1, y: 0.28, z: 0.35 },
    { x: 0, y: 2.05, z: 0 },
    '#EBCFBD',
  );

  // Bottom frame.
  addBox(
    machine,
    { x: 6.1, y: 0.28, z: 0.35 },
    { x: 0, y: -1.45, z: 0 },
    '#EBCFBD',
  );

  // Central support.
  addBox(
    machine,
    { x: 0.22, y: 3.1, z: 0.3 },
    { x: 0, y: 0.1, z: -0.05 },
    '#DCCFF4',
  );

  scene.add(machine);

  return machine;
}

export default function ManufacturingScreen() {
  const [selectedPart, setSelectedPart] = useState<PartId | null>(null);
  const [placed, setPlaced] = useState<Record<PartId, boolean>>({
    bigGear: false,
    smallGear: false,
    shaft: false,
  });
  const [running, setRunning] = useState(false);
  const [message, setMessage] = useState(
    'Choose a part, then tap its glowing place.',
  );

  const selectedRef = useRef<PartId | null>(null);
  const placedRef = useRef(placed);
  const runningRef = useRef(false);

  const viewportRef = useRef({
    width: 1,
    height: 1,
  });

  const lookRef = useRef({
    yaw: 0,
    pitch: 0,
  });

  const dragStartRef = useRef({
    x: 0,
    y: 0,
    yaw: 0,
    pitch: 0,
  });

  const sceneRef = useRef<THREE.Scene | null>(null);
  const cameraRef = useRef<THREE.PerspectiveCamera | null>(null);
  const rendererRef = useRef<THREE.WebGLRenderer | null>(null);

  const objectsRef = useRef<{
    bigGear?: THREE.Mesh;
    smallGear?: THREE.Mesh;
    shaft?: THREE.Mesh;
    targets: Record<PartId, THREE.Group>;
  }>({
    targets: {
      bigGear: new THREE.Group(),
      smallGear: new THREE.Group(),
      shaft: new THREE.Group(),
    },
  });

  useEffect(() => {
    selectedRef.current = selectedPart;
  }, [selectedPart]);

  useEffect(() => {
    placedRef.current = placed;
  }, [placed]);

  useEffect(() => {
    runningRef.current = running;
  }, [running]);

  const selectPart = (part: PartId) => {
    if (placed[part]) {
      setMessage(`${PART_LABELS[part]} is already installed.`);
      return;
    }

    selectedRef.current = part;
    setSelectedPart(part);
    setMessage(`Now tap the glowing ${PART_LABELS[part]} socket.`);
  };

  const placeSelectedPart = (part: PartId) => {
    const selected = selectedRef.current;

    if (!selected) {
      setMessage('Choose a part from the top first.');
      return;
    }

    if (selected !== part) {
      setMessage(`That socket is for the ${PART_LABELS[part]}.`);
      return;
    }

    const object = objectsRef.current[selected];
    if (!object) return;

    const target = TARGETS[selected];

    const start = {
      x: object.position.x,
      y: object.position.y,
      z: object.position.z,
    };

    const startTime = performance.now();
    const duration = 420;

    const animateSnap = (time: number) => {
      const progress = Math.min(
        1,
        (time - startTime) / duration,
      );

      const eased =
        1 - Math.pow(1 - progress, 3);

      object.position.x =
        start.x + (target.x - start.x) * eased;

      object.position.y =
        start.y + (target.y - start.y) * eased;

      object.position.z =
        start.z + (target.z - start.z) * eased;

      object.rotation.z =
        progress * Math.PI * 1.5;

      if (progress < 1) {
        requestAnimationFrame(animateSnap);
      } else {
        object.rotation.z = 0;

        setPlaced((current) => ({
          ...current,
          [selected]: true,
        }));

        placedRef.current = {
          ...placedRef.current,
          [selected]: true,
        };

        selectedRef.current = null;
        setSelectedPart(null);

        const nextCount =
          Object.values({
            ...placedRef.current,
            [selected]: true,
          }).filter(Boolean).length;

        if (nextCount === 3) {
          setMessage('Machine complete. Press RUN MACHINE.');
        } else {
          setMessage('Nice! Choose the next part.');
        }
      }
    };

    requestAnimationFrame(animateSnap);
  };

  const onContextCreate = async (gl: any) => {
    const width = gl.drawingBufferWidth;
    const height = gl.drawingBufferHeight;

    viewportRef.current = {
      width,
      height,
    };

    const scene = new THREE.Scene();

    scene.background = new THREE.Color(COLORS.background);
    scene.fog = new THREE.Fog(
      COLORS.background,
      7,
      16,
    );

    sceneRef.current = scene;

    const camera = new THREE.PerspectiveCamera(
      55,
      width / height,
      0.1,
      100,
    );

    camera.position.set(0, 0.15, 8);
    camera.lookAt(0, 0, 0);

    cameraRef.current = camera;

    const renderer = new THREE.WebGLRenderer({
      context: gl,
      antialias: true,
    });

    renderer.setSize(
      width,
      height,
      false,
    );

    renderer.setPixelRatio(1);

    rendererRef.current = renderer;

    const hemisphere = new THREE.HemisphereLight(
      '#FFFFFF',
      '#D9CBE8',
      2.3,
    );

    scene.add(hemisphere);

    const directional = new THREE.DirectionalLight(
      '#FFFFFF',
      3,
    );

    directional.position.set(
      -4,
      6,
      7,
    );

    scene.add(directional);

    const point = new THREE.PointLight(
      COLORS.purple,
      4,
      10,
    );

    point.position.set(
      0,
      1.5,
      4,
    );

    scene.add(point);

    createMachine(scene);

    // Target sockets.
    (
      Object.keys(TARGETS) as PartId[]
    ).forEach((part) => {
      const color =
        part === 'shaft'
          ? COLORS.peach
          : COLORS.purple;

      const target = createTargetRing(
        TARGETS[part],
        color,
      );

      target.visible = true;

      scene.add(target);

      objectsRef.current.targets[part] =
        target;
    });

    // Gears.
    const bigGear = createGear(
      0.82,
      12,
      COLORS.lavender,
    );

    bigGear.position.set(
      TARGETS.bigGear.x,
      TARGETS.bigGear.y,
      -0.05,
    );

    bigGear.visible = false;

    scene.add(bigGear);

    const smallGear = createGear(
      0.57,
      10,
      COLORS.sky,
    );

    smallGear.position.set(
      TARGETS.smallGear.x,
      TARGETS.smallGear.y,
      -0.05,
    );

    smallGear.visible = false;

    scene.add(smallGear);

    // Shaft.
    const shaftGeometry =
      new THREE.CylinderGeometry(
        0.14,
        0.14,
        2.7,
        32,
      );

    const shaft = new THREE.Mesh(
      shaftGeometry,
      makeMaterial(
        COLORS.peach,
        0.75,
        0.25,
      ),
    );

    shaft.rotation.z =
      Math.PI / 2;

    shaft.position.set(
      TARGETS.shaft.x,
      TARGETS.shaft.y,
      -0.05,
    );

    shaft.visible = false;

    scene.add(shaft);

    // Axles behind gears.
    const axleGeometry =
      new THREE.CylinderGeometry(
        0.18,
        0.18,
        0.35,
        24,
      );

    const axleMaterial =
      makeMaterial(
        '#D8C7E8',
        0.65,
        0.3,
      );

    const axleA =
      new THREE.Mesh(
        axleGeometry,
        axleMaterial,
      );

    axleA.rotation.z =
      Math.PI / 2;

    axleA.position.set(
      TARGETS.bigGear.x,
      TARGETS.bigGear.y,
      -0.38,
    );

    scene.add(axleA);

    const axleB =
      new THREE.Mesh(
        axleGeometry,
        axleMaterial,
      );

    axleB.rotation.z =
      Math.PI / 2;

    axleB.position.set(
      TARGETS.smallGear.x,
      TARGETS.smallGear.y,
      -0.38,
    );

    scene.add(axleB);

    objectsRef.current.bigGear =
      bigGear;

    objectsRef.current.smallGear =
      smallGear;

    objectsRef.current.shaft =
      shaft;

    const animate = () => {
      requestAnimationFrame(animate);

      const yaw =
        lookRef.current.yaw;

      const pitch =
        lookRef.current.pitch;

      const radius = 8;

      camera.position.x =
        Math.sin(yaw) *
        Math.cos(pitch) *
        radius;

      camera.position.y =
        0.15 +
        Math.sin(pitch) *
        radius;

      camera.position.z =
        Math.cos(yaw) *
        Math.cos(pitch) *
        radius;

      camera.lookAt(
        0,
        0,
        0,
      );

      const selected =
        selectedRef.current;

      (
        Object.keys(
          objectsRef.current.targets,
        ) as PartId[]
      ).forEach((part) => {
        const target =
          objectsRef.current.targets[
            part
          ];

        if (
          placedRef.current[part]
        ) {
          target.visible = false;
          return;
        }

        target.visible = true;

        const active =
          selected === part;

        const pulse =
          1 +
          Math.sin(
            performance.now() / 180,
          ) *
          0.08;

        target.scale.set(
          active ? 1.18 * pulse : pulse,
          active ? 1.18 * pulse : pulse,
          active ? 1.18 * pulse : pulse,
        );

        target.rotation.z =
          performance.now() / 1800;
      });

      if (runningRef.current) {
        if (
          objectsRef.current.bigGear
        ) {
          objectsRef.current.bigGear.rotation.z +=
            0.025;
        }

        if (
          objectsRef.current.smallGear
        ) {
          objectsRef.current.smallGear.rotation.z -=
            0.036;
        }

        if (
          objectsRef.current.shaft
        ) {
          objectsRef.current.shaft.rotation.x +=
            0.055;
        }
      }

      renderer.render(
        scene,
        camera,
      );

      gl.endFrameEXP();
    };

    animate();
  };

  const handleTouchStart = (
    event: any,
  ) => {
    const native =
      event?.nativeEvent;

    dragStartRef.current = {
      x: native?.locationX ?? 0,
      y: native?.locationY ?? 0,
      yaw: lookRef.current.yaw,
      pitch: lookRef.current.pitch,
    };
  };

  const handleTouchMove = (
    event: any,
  ) => {
    const native =
      event?.nativeEvent;

    const dx =
      (native?.locationX ?? 0) -
      dragStartRef.current.x;

    const dy =
      (native?.locationY ?? 0) -
      dragStartRef.current.y;

    lookRef.current.yaw =
      dragStartRef.current.yaw -
      dx * 0.004;

    lookRef.current.pitch =
      Math.max(
        -0.35,
        Math.min(
          0.35,
          dragStartRef.current.pitch -
            dy * 0.003,
        ),
      );
  };

  const handleTouchEnd = (
    event: any,
  ) => {
    const native =
      event?.nativeEvent;

    const dx =
      (native?.locationX ?? 0) -
      dragStartRef.current.x;

    const dy =
      (native?.locationY ?? 0) -
      dragStartRef.current.y;

    // Small movement = tap.
    if (
      Math.abs(dx) < 14 &&
      Math.abs(dy) < 14
    ) {
      const width =
        viewportRef.current.width;

      const height =
        viewportRef.current.height;

      const x =
        (native?.locationX ?? 0) /
        width;

      const y =
        (native?.locationY ?? 0) /
        height;

      // Map screen zones to forgiving machine zones.
      if (
        x < 0.42 &&
        y > 0.25 &&
        y < 0.62
      ) {
        placeSelectedPart('bigGear');
        return;
      }

      if (
        x > 0.58 &&
        y > 0.25 &&
        y < 0.62
      ) {
        placeSelectedPart('smallGear');
        return;
      }

      if (
        x >= 0.38 &&
        x <= 0.62 &&
        y > 0.62 &&
        y < 0.9
      ) {
        placeSelectedPart('shaft');
        return;
      }

      setMessage(
        'Tap the glowing socket on the machine.',
      );
    }
  };

  const runMachine = () => {
    const complete =
      Object.values(placed).every(
        Boolean,
      );

    if (!complete) {
      setMessage(
        'Install all three parts first.',
      );
      return;
    }

    setRunning(true);
    runningRef.current = true;

    setMessage(
      'Machine running! Watch the gears move.',
    );
  };

  const resetMachine = () => {
    runningRef.current = false;
    selectedRef.current = null;

    setRunning(false);
    setSelectedPart(null);

    const resetPlaced = {
      bigGear: false,
      smallGear: false,
      shaft: false,
    };

    setPlaced(resetPlaced);
    placedRef.current = resetPlaced;

    (
      Object.keys(TARGETS) as PartId[]
    ).forEach((part) => {
      const object =
        objectsRef.current[part];

      if (!object) return;

      object.visible = false;

      object.position.set(
        0,
        -3.5,
        0,
      );

      object.rotation.set(
        0,
        0,
        0,
      );

      objectsRef.current.targets[
        part
      ].visible = true;
    });

    lookRef.current = {
      yaw: 0,
      pitch: 0,
    };

    setMessage(
      'Choose a part, then tap its glowing place.',
    );
  };

  const placedCount =
    Object.values(placed).filter(
      Boolean,
    ).length;

  return (
    <SafeAreaView
      style={styles.safe}
    >
      <View style={styles.container}>
        <View style={styles.header}>
          <View>
            <Text style={styles.kicker}>
              TECH • LEVEL 1
            </Text>

            <Text style={styles.title}>
              BUILD THE MACHINE
            </Text>

            <Text style={styles.subtitle}>
              Place the parts. Then run it.
            </Text>
          </View>

          <View style={styles.counter}>
            <Text style={styles.counterText}>
              {placedCount}/3
            </Text>
          </View>
        </View>

        <View style={styles.partsRow}>
          {(
            Object.keys(
              PART_LABELS,
            ) as PartId[]
          ).map((part) => {
            const active =
              selectedPart === part;

            const done =
              placed[part];

            return (
              <Pressable
                key={part}
                onPress={() =>
                  selectPart(part)
                }
                style={[
                  styles.partCard,
                  active &&
                    styles.partCardActive,
                  done &&
                    styles.partCardDone,
                ]}
              >
                <View
                  style={[
                    styles.partIcon,
                    part ===
                      'bigGear' &&
                      styles.bigIcon,
                    part ===
                      'smallGear' &&
                      styles.smallIcon,
                    part ===
                      'shaft' &&
                      styles.shaftIcon,
                  ]}
                >
                  {part ===
                    'shaft' ? (
                    <View
                      style={
                        styles.shaftVisual
                      }
                    />
                  ) : (
                    <View
                      style={[
                        styles.gearVisual,
                        part ===
                          'smallGear' &&
                          styles.smallGearVisual,
                      ]}
                    >
                      <View
                        style={
                          styles.gearHole
                        }
                      />
                    </View>
                  )}
                </View>

                <Text
                  style={
                    styles.partLabel
                  }
                >
                  {done
                    ? '✓'
                    : PART_LABELS[
                        part
                      ]}
                </Text>
              </Pressable>
            );
          })}
        </View>

        <View
          style={styles.sceneWrapper}
          onLayout={(event) => {
            const {
              width,
              height,
            } =
              event.nativeEvent.layout;

            viewportRef.current = {
              width,
              height,
            };
          }}
        >
          <GLView
            style={styles.gl}
            onContextCreate={
              onContextCreate
            }
            onStartShouldSetResponder={() =>
              true
            }
            onResponderGrant={
              handleTouchStart
            }
            onResponderMove={
              handleTouchMove
            }
            onResponderRelease={
              handleTouchEnd
            }
          />

          <View
            pointerEvents="none"
            style={styles.sceneHint}
          >
            <Text
              style={
                styles.sceneHintText
              }
            >
              {message}
            </Text>
          </View>

          <View
            pointerEvents="none"
            style={styles.dragHint}
          >
            <Text
              style={styles.dragHintText}
            >
              ↔ DRAG TO LOOK AROUND
            </Text>
          </View>
        </View>

        <View style={styles.bottom}>
          <Pressable
            onPress={runMachine}
            style={[
              styles.runButton,
              placedCount !== 3 &&
                styles.runButtonDisabled,
            ]}
          >
            <Text
              style={styles.runText}
            >
              {running
                ? 'MACHINE RUNNING'
                : '▶  RUN MACHINE'}
            </Text>
          </Pressable>

          <Pressable
            onPress={resetMachine}
            style={styles.resetButton}
          >
            <Text
              style={styles.resetText}
            >
              RESET
            </Text>
          </Pressable>
        </View>
      </View>
    </SafeAreaView>
  );
}

